{
  "name": "workerspy",
  "version": "0.0.0",
  "scripts": {
    "typecheck": "pnpm run -r typecheck",
    "dev": "pnpm run -r dev",
    "db:generate": "pnpm run --filter='@workerspy/core' db:generate",
    "db:migrate:local": "pnpm run --filter='@workerspy/worker' db:migrate:local",
    "db:migrate:prod": "pnpm run --filter='@workerspy/worker' db:migrate:prod",
    "db:studio:local": "pnpm run --filter='@workerspy/core' db:studio:local",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tsconfig/node20": "^20.1.4",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "pnpm": {
    "overrides": {
      "body-parser@<2": "1.20.9",
      "body-parser@>=2 <3": "2.4.0",
      "toml": "5.0.1",
      "vite@<7": "6.4.4",
      "vite@>=7 <8": "7.3.7",
      "vite@>=8 <8.2": "8.1.6",
      "vite@>=8.2 <8.3": "8.2.4",
      "vite@>=8.3 <9": "8.3.3",
      "undici@>=6 <7": "6.29.1",
      "undici@>=7 <8": "7.30.1",
      "undici@>=8 <9": "8.12.2"
    }
  }
}
